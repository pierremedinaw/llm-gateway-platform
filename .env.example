# Copiar como .env. NUNCA publicar .env ni subir credenciales a GitHub.
GATEWAY_API_KEY=replace-this-with-a-long-random-secret-please

# Rutas simultáneas por alias (solo mock activado hasta que configures el resto).
# Para habilitar modelos reales, sustituye el JSON de MODEL_ROUTES por el ejemplo del README.
MODEL_ROUTES={"demo-model":{"provider":"mock","upstream_model":"demo-model"}}

# Compatibilidad con Fase 1 cuando MODEL_ROUTES={}:
PROVIDER=mock
ALLOWED_MODELS=demo-model
PROVIDER_API_KEY=

# OpenAI o servicio con API compatible con OpenAI (ej. otros gateways):
OPENAI_API_KEY=
PROVIDER_BASE_URL=https://api.openai.com/v1

# API nativa Gemini: https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=gen-lang-client-0977287008

REQUESTS_PER_MINUTE=20
PROVIDER_TIMEOUT_SECONDS=20
# Por defecto 0 para evitar peticiones duplicadas y costes accidentales.
MAX_UPSTREAM_RETRIES=0
RETRY_BACKOFF_SECONDS=0.25
